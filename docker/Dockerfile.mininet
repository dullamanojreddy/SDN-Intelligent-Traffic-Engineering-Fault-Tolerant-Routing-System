# Linux test bench for SDN-ITE: Mininet + Open vSwitch + the project's Python deps.
# Build:  docker build -f docker/Dockerfile.mininet -t sdn-ite-bench .
# Run:    see docs/REAL_DATAPLANE_TESTING.md (needs --privileged).
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        mininet openvswitch-switch iproute2 iputils-ping iperf3 net-tools procps \
        python3 python3-pip python3-venv curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt
WORKDIR /work

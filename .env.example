# ==============================================================================
# SDN-ITE Production Environment Configuration (Final Draft)
# ==============================================================================
# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Controller Configuration
CONTROLLER_HOST=127.0.0.1
CONTROLLER_OF_PORT=6653
CONTROLLER_REST_PORT=8080
CONTROLLER_API_URL=http://127.0.0.1:8080
# Required: use the same strong, non-default secret for controller and backend.
CONTROLLER_API_TOKEN=replace-with-a-strong-random-secret

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=sdn_traffic_engineering

# Traffic Engineering & Intelligence Thresholds
MONITOR_INTERVAL_SEC=2.0
UTILIZATION_THRESHOLD_PCT=85.0
CONGESTION_PERSISTENCE_CYCLES=3
CONGESTION_COOLDOWN_SEC=10.0

# Multi-Metric Routing Cost Weights
LATENCY_WEIGHT=0.4
UTILIZATION_WEIGHT=0.4
LOSS_WEIGHT=0.2

# QoS Class Weights (Latency, Utilization, Loss)
QOS_VOICE_WEIGHTS=0.7,0.1,0.2
QOS_VIDEO_WEIGHTS=0.2,0.6,0.2
QOS_WEB_WEIGHTS=0.4,0.4,0.2
QOS_BACKGROUND_WEIGHTS=0.1,0.8,0.1

# ------------------------------------------------------------------------------
# High availability, live network and verification (see docs/REAL_DATAPLANE_TESTING.md)
# ------------------------------------------------------------------------------
# Standby controller management URL(s), comma separated (tried in order on failure)
# CONTROLLER_BACKUP_API_URLS=http://127.0.0.1:8081
# Mininet network agent (enables real topology edits, flow verification, real traffic)
# NETWORK_AGENT_URL=http://127.0.0.1:9100
# NETWORK_AGENT_TOKEN=replace-with-a-strong-random-secret   # defaults to CONTROLLER_API_TOKEN
# Per-controller-instance settings (set different values for a standby):
# CONTROLLER_OF_PORT=6653
# CONTROLLER_REST_PORT=8080
# CONTROLLER_ID=primary
# CONTROLLER_ROLE=primary                  # or "standby"
# CONTROLLER_PEER_API_URL=http://127.0.0.1:8081
# Set to false on any network other than the built-in demo mesh (s1-s7, hosts 10.0.0.1/2/7/8)
# CONTROLLER_SEED_MESH=false
# Routing policy
# ROUTE_OVER_UNCONFIRMED_LINKS=false       # never route over links not seen in the data plane
# CAPACITY_WEIGHT=0.0                      # weight of the link-capacity term (VIDEO class uses 0.15)
# UTILIZATION_NOISE_FLOOR_PCT=1.0

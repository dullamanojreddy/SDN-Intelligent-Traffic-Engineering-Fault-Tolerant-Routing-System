# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Controller Configuration
CONTROLLER_HOST=127.0.0.1
CONTROLLER_OF_PORT=6653
CONTROLLER_REST_PORT=8080

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=sdn_traffic_engineering

# Traffic Engineering & Intelligence Thresholds
MONITOR_INTERVAL_SEC=2.0
UTILIZATION_THRESHOLD_PCT=85.0
CONGESTION_PERSISTENCE_CYCLES=3
CONGESTION_COOLDOWN_SEC=10.0

# Multi-Metric Routing Cost Weights
LATENCY_WEIGHT=0.4
UTILIZATION_WEIGHT=0.4
LOSS_WEIGHT=0.2

# QoS Class Weights (Latency, Utilization, Loss)
QOS_VOICE_WEIGHTS=0.7,0.1,0.2
QOS_VIDEO_WEIGHTS=0.2,0.6,0.2
QOS_WEB_WEIGHTS=0.4,0.4,0.2
QOS_BACKGROUND_WEIGHTS=0.1,0.8,0.1
